# --- Prisma → Supabase Postgres (wajib untuk URL shortener) ---
#
# Jika `npx prisma migrate` error P1001 ("Can't reach database server") pada host
# `db.<ref>.supabase.co`: koneksi *direct* itu IPv6-first. Di Windows / jaringan IPv4-only,
# pakai string **Session mode** dari Dashboard → Connect → Session (bukan host `db.*`).
# Lihat: https://supabase.com/docs/guides/database/connecting-to-postgres
#
# Pooler (Transaction mode), port 6543 — runtime Next.js / serverless
# Host di dashboard bisa aws-0- atau aws-1- — salin persis dari Connect → Transaction pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler, port 5432 — untuk `prisma migrate` / introspection (CLI: prisma.config.ts → DIRECT_URL)
# Connect → pilih tab **Session pooler** (bukan Direct, bukan Transaction). Salin URI-nya ke sini.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase project (Auth / OAuth nanti; URL shortener tidak memakai ini) ---
# Dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="eyJ..."

# Opsional: hanya server (bypass RLS) — jangan expose ke client
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
